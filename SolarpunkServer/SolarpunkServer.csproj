<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SolarpunkServer</RootNamespace>
    <UserSecretsId>solarpunk-server-dev</UserSecretsId>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <!-- .NET 9+ marks the apphost CET-compatible (hardware shadow stacks) by default, and the runtime then refuses to
         start on a machine whose CPU has CET but whose Windows build does not fully support it ("Your Windows doesn't
         fully support CET"): seen on a Windows Server 2022 build 20348.320 host with a Zen 3 CPU, 2026-11-03.
         scripts/check-cet-compat.py fails the release if the shipped exe carries the flag. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SolarpunkServer.Tests" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Solarpunk.Protocol/Solarpunk.Protocol.csproj" />
    <ProjectReference Include="../Solarpunk.Abstractions/Solarpunk.Abstractions.csproj" />
    <ProjectReference Include="../Solarpunk.SourceQuery/Solarpunk.SourceQuery.csproj" />
    <ProjectReference Include="../Solarpunk.Rcon/Solarpunk.Rcon.csproj" />
    <ProjectReference Include="../Solarpunk.Persistence/Solarpunk.Persistence.csproj" />
  </ItemGroup>
</Project>
